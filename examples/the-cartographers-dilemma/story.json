  "arcs": {
    "awakening": {
      "goal": "The cartographer discovers that their maps are reshaping reality",
      "beat_ids": ["b1"],
      "status": "done",
      "summary": "The cartographer wakes to find ink bleeding across a map, forming features that now exist in the world. The Guild brands their door with a summons.",
      "scenes": [
        {"id": "sc1", "title": "The Bleeding Ink", "summary": "The cartographer examines the map that drew itself", "keywords": ["discovery", "ink", "magic"], "characters": [], "beat_ids": ["b1"], "passage_id": "awakening__examine_ink", "status": "drafted"},
        {"id": "sc2", "title": "The Guild Summons", "summary": "The Guild brands the door with a summons", "keywords": ["guild", "summons", "danger"], "characters": [], "beat_ids": ["b1"], "passage_id": "awakening__front_door", "status": "drafted"},
        {"id": "sc3", "title": "Burning the Map", "summary": "The cartographer tries to destroy evidence but makes things worse", "keywords": ["fire", "river", "consequence"], "characters": ["maren"], "beat_ids": ["b1"], "passage_id": "awakening__hide_map", "status": "drafted"}
      ]
    },
    "the_guild": {
      "goal": "The Cartographers' Guild confronts the cartographer about their power",
      "beat_ids": ["b2"],
      "status": "done",
      "summary": "Hallmaster Voss reveals the Guild's history with mapmakers who write true. The cartographer faces binding, recruitment, or flight.",
      "scenes": [
        {"id": "sc1", "title": "The Hallmaster", "summary": "Voss confronts the cartographer with the recovered map", "keywords": ["guild", "interrogation", "truth"], "characters": ["voss"], "beat_ids": ["b2"], "passage_id": "the_guild__guild_hall", "status": "drafted"},
        {"id": "sc2", "title": "Written True", "summary": "Voss explains what writing true means and the Guild's purpose", "keywords": ["lore", "history", "power"], "characters": ["voss"], "beat_ids": ["b2"], "passage_id": "the_guild__written_true", "status": "drafted"},
        {"id": "sc3", "title": "Binding", "summary": "The cartographer accepts binding and loses the gift forever", "keywords": ["sacrifice", "loss", "ending"], "characters": ["voss"], "beat_ids": ["b2"], "passage_id": "the_guild__binding", "status": "drafted"}
      ]
    },
    "the_frontier": {
      "goal": "The cartographer flees to the Salt Wastes to escape the Collectors",
      "beat_ids": ["b3"],
      "status": "done",
      "summary": "The cartographer flees through the changed Veilwood to the blank Salt Wastes, seeking a place to draw without consequence.",
      "scenes": [
        {"id": "sc1", "title": "Departure", "summary": "The cartographer flees the city before Collectors arrive", "keywords": ["flight", "ink", "frontier"], "characters": [], "beat_ids": ["b3"], "passage_id": "the_frontier__departure", "status": "drafted"},
        {"id": "sc2", "title": "The Changed Veilwood", "summary": "The forest has become the map the cartographer drew", "keywords": ["forest", "transformation", "danger"], "characters": [], "beat_ids": ["b3"], "passage_id": "the_frontier__veilwood", "status": "drafted"},
        {"id": "sc3", "title": "The Salt Wastes", "summary": "The cartographer reaches the blank canvas of the wastes", "keywords": ["waste", "blank", "canvas"], "characters": [], "beat_ids": ["b3"], "passage_id": "the_frontier__cross_country", "status": "drafted"}
      ]
    },
    "the_betrayal": {
      "goal": "Maren the apprentice learns the gift and betrays the cartographer",
      "beat_ids": ["b4"],
      "status": "done",
