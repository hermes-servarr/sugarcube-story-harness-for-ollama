{
  "name": "sugarcube-harness-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run contracts:check && tsc --noEmit && vite build",
    "test": "vitest run",
    "contracts:generate": "python ../scripts/export_openapi.py openapi.json && node scripts/generate-contracts.mjs",
    "contracts:check": "python ../scripts/export_openapi.py --check openapi.json && node scripts/generate-contracts.mjs --check"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
