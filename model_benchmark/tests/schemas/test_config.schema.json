{
  "$defs": {
    "DatasetReference": {
      "additionalProperties": false,
      "description": "Reference to an external or inline dataset.\n\nTests can reference datasets by path, HuggingFace identifier, or inline\ndata.  The loader (t_172dd683) resolves the reference, fetches the data,\nand injects rows as parameterized test inputs.",
      "properties": {
        "name": {
          "description": "Stable dataset identifier",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dataset version tag",
          "title": "Version"
        },
        "split": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Train/val/test split name",
          "title": "Split"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local file path (portable, not absolute)",
          "title": "Path"
        },
        "format": {
          "default": "jsonl",
          "enum": [
            "csv",
            "jsonl",
            "json",
            "huggingface",
            "inline"
          ],
          "title": "Format",
          "type": "string"
        },
        "huggingface_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HF dataset repo ID (e.g. 'squad')",
          "title": "Huggingface Id"
        },
        "filters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Row filters applied at load time",
          "title": "Filters"
        },
        "sample": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Random sample N rows",
          "title": "Sample"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seed for sampling",
          "title": "Seed"
        },
        "checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Content checksum (sha256) for integrity",
          "title": "Checksum"
        },
        "inline_data": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inline rows (format=inline)",
          "title": "Inline Data"
        }
      },
      "required": [
        "name"
      ],
      "title": "DatasetReference",
      "type": "object"
    },
    "DefaultsDocument": {
      "additionalProperties": false,
      "description": "Global defaults document \u2014 sets default values for all tests.\n\nLoaded first; suite and test layers merge on top.",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "defaults",
          "default": "defaults",
          "title": "Kind",
          "type": "string"
        },
        "defaults": {
          "$ref": "#/$defs/TestConfig",
          "description": "Default values applied to all tests"
        },
        "merge": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "defaults"
      ],
      "title": "DefaultsDocument",
      "type": "object"
    },
    "EvaluatorReference": {
      "additionalProperties": false,
      "description": "Reference to an evaluator plugin with optional parameters.\n\nConfig files reference evaluators by name with optional parameters::\n\n    evaluation:\n      name: semantic_similarity\n      type: llm_judge\n      params:\n        threshold: 0.8\n      pass_threshold: 1.0\n\nBuilt-in evaluators (t_b8e82f29): exact_match, substring_regex, llm_judge.\nCustom evaluators are discovered via the plugin registry.",
      "properties": {
        "name": {
          "description": "Evaluator plugin name (unique ID)",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evaluator category (exact_match, regex, llm_judge, ...)",
          "title": "Type"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evaluator version for traceability",
          "title": "Version"
        },
        "params": {
          "additionalProperties": true,
          "description": "Evaluator-specific parameters",
          "title": "Params",
          "type": "object"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Evaluator prompt (inline text or template ref)",
          "title": "Prompt"
        },
        "prompt_template_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to a prompt template file",
          "title": "Prompt Template Ref"
        },
        "pass_threshold": {
          "default": 1.0,
          "description": "Minimum normalized score to pass",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Pass Threshold",
          "type": "number"
        },
        "max_score": {
          "default": 1.0,
          "description": "Maximum raw score",
          "exclusiveMinimum": 0.0,
          "title": "Max Score",
          "type": "number"
        },
        "deterministic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether the evaluator is deterministic",
          "title": "Deterministic"
        }
      },
      "required": [
        "name"
      ],
      "title": "EvaluatorReference",
      "type": "object"
    },
    "ExpectedBehavior": {
      "additionalProperties": false,
      "description": "Descriptors for the expected model behavior.\n\nCombines a reference answer, behavioral constraints, a scoring rubric,\nand simple match checks (contains / not_contains / regex).  The evaluator\nuses whichever fields are relevant to its type.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference / gold answer",
          "title": "Answer"
        },
        "answer_type": {
          "anyOf": [
            {
              "enum": [
                "exact",
                "numeric",
                "multiple_choice",
                "structured",
                "free_text"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Type"
        },
        "answer_choices": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Choices for multiple_choice",
          "title": "Answer Choices"
        },
        "numeric_tolerance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tolerance for numeric answers",
          "title": "Numeric Tolerance"
        },
        "behavior": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Behavioral descriptors the model should exhibit",
          "title": "Behavior"
        },
        "rubric": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Scoring rubric items [{criterion, weight, description}]",
          "title": "Rubric"
        },
        "constraints": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Constraints the answer must satisfy",
          "title": "Constraints"
        },
        "contains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Substrings the output must contain",
          "title": "Contains"
        },
        "not_contains": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Substrings the output must NOT contain",
          "title": "Not Contains"
        },
        "regex": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex patterns the output must match",
          "title": "Regex"
        },
        "must_parse_as": {
          "anyOf": [
            {
              "enum": [
                "json",
                "yaml",
                "csv",
                "sugarcube_passage"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Must Parse As"
        }
      },
      "title": "ExpectedBehavior",
      "type": "object"
    },
    "MatrixConfig": {
      "additionalProperties": false,
      "description": "Controls how parameterized matrix dimensions expand into concrete cases.\n\nThe ``parameters`` dict on the test defines dimension names \u2192 value lists.\nThis model controls the combination strategy and explosion limits.",
      "properties": {
        "strategy": {
          "default": "full",
          "enum": [
            "full",
            "pairwise",
            "explicit",
            "sample"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "max_cases": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hard cap on generated cases (prevents explosion)",
          "title": "Max Cases"
        },
        "sample_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "N for 'sample' strategy",
          "title": "Sample Size"
        },
        "explicit_combinations": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit dimension combos for 'explicit' strategy [{context_length: 4000, ...}]",
          "title": "Explicit Combinations"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seed for 'sample' strategy",
          "title": "Seed"
        }
      },
      "title": "MatrixConfig",
      "type": "object"
    },
    "MergePolicy": {
      "additionalProperties": false,
      "description": "Declares how list fields merge with parent-layer defaults.\n\nApplied when this document's values are merged onto a parent layer\n(defaults \u2192 suite \u2192 test).  Dict fields always deep-merge; scalars always\nreplace.  Only list fields are controlled here.\n\n``tags`` always union (deduplicated) regardless of policy \u2014 it is a\nsemantic set, not an ordered list.",
      "properties": {
        "list_strategy": {
          "default": "replace",
          "description": "Default strategy for all list fields: replace or append",
          "enum": [
            "replace",
            "append"
          ],
          "title": "List Strategy",
          "type": "string"
        },
        "field_overrides": {
          "additionalProperties": {
            "enum": [
              "replace",
              "append"
            ],
            "type": "string"
          },
          "description": "Per-field override, e.g. {tags: append, models: replace}",
          "title": "Field Overrides",
          "type": "object"
        }
      },
      "title": "MergePolicy",
      "type": "object"
    },
    "ModelEligibility": {
      "additionalProperties": false,
      "description": "Constraints on which models may run this test.",
      "properties": {
        "required": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model tags that CAN run this test (allowlist)",
          "title": "Required"
        },
        "excluded": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model tags that CANNOT run (denylist)",
          "title": "Excluded"
        },
        "min_context_length": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Context Length"
        },
        "min_parameters": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum model parameter count (e.g. 7_000_000_000)",
          "title": "Min Parameters"
        },
        "required_capabilities": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required model capabilities (e.g. 'tool_use', 'vision')",
          "title": "Required Capabilities"
        }
      },
      "title": "ModelEligibility",
      "type": "object"
    },
    "ModelParameters": {
      "additionalProperties": false,
      "description": "Generation parameters sent to the model backend (Ollama).\n\nFields mirror ``BenchmarkConfig`` in benchmark.py so the declarative config\ncan drive the existing engine without translation.",
      "properties": {
        "base_url": {
          "default": "http://localhost:11434",
          "title": "Base Url",
          "type": "string"
        },
        "timeout": {
          "default": 120,
          "description": "Seconds per model call",
          "exclusiveMinimum": 0,
          "title": "Timeout",
          "type": "integer"
        },
        "num_predict": {
          "default": 640,
          "description": "Max tokens to generate",
          "exclusiveMinimum": 0,
          "title": "Num Predict",
          "type": "integer"
        },
        "temperature": {
          "default": 0.2,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        },
        "top_k": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top K"
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "stop": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop"
        },
        "repeat_penalty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Penalty"
        }
      },
      "title": "ModelParameters",
      "type": "object"
    },
    "PromptTemplate": {
      "additionalProperties": false,
      "description": "Prompt template \u2014 either a reference to a file or inline text.\n\n``ref`` and ``text`` are mutually exclusive.  ``variant`` selects the\nharness.prompts builder when using built-in templates.",
      "properties": {
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to a template file (relative to tests/prompts/)",
          "title": "Ref"
        },
        "variant": {
          "anyOf": [
            {
              "enum": [
                "compact",
                "full",
                "json"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Built-in variant: compact/full/json",
          "title": "Variant"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inline Jinja2/text template",
          "title": "Text"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template version for traceability",
          "title": "Version"
        },
        "input_variables": {
          "additionalProperties": true,
          "description": "Variables injected into the template",
          "title": "Input Variables",
          "type": "object"
        }
      },
      "title": "PromptTemplate",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Retry policy for flaky model calls or evaluator errors.",
      "properties": {
        "max_retries": {
          "default": 0,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "backoff": {
          "default": "exponential",
          "enum": [
            "fixed",
            "linear",
            "exponential"
          ],
          "title": "Backoff",
          "type": "string"
        },
        "initial_delay": {
          "default": 1.0,
          "description": "Initial delay in seconds",
          "exclusiveMinimum": 0.0,
          "title": "Initial Delay",
          "type": "number"
        },
        "max_delay": {
          "default": 60.0,
          "description": "Maximum delay cap in seconds",
          "exclusiveMinimum": 0.0,
          "title": "Max Delay",
          "type": "number"
        },
        "retry_on": {
          "description": "Error categories that trigger a retry",
          "items": {
            "type": "string"
          },
          "title": "Retry On",
          "type": "array"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "SuiteDocument": {
      "additionalProperties": false,
      "description": "Test suite \u2014 a named collection of tests with suite-level overrides.\n\nLists tests by ID reference or inline definition.  Suite-level ``defaults``\nmerge between global defaults and individual test config.",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "const": "suite",
          "default": "suite",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "description": "Unique suite name (required)",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "defaults": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Suite-level overrides applied to all tests in this suite"
        },
        "tests": {
          "description": "Test IDs (string references) or inline TestConfig definitions",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/TestConfig"
              }
            ]
          },
          "minItems": 1,
          "title": "Tests",
          "type": "array"
        },
        "tags": {
          "description": "Suite-level tags inherited by member tests",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "merge": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "tests"
      ],
      "title": "SuiteDocument",
      "type": "object"
    },
    "TestConfig": {
      "additionalProperties": false,
      "description": "A single test definition \u2014 or a partial overlay used as defaults.\n\nEvery field is optional so this model can serve three roles:\n* As a complete test (``kind: test``) \u2014 ``id`` is required, others optional.\n* As suite-level overrides (``kind: suite`` \u2192 ``defaults: TestConfig``).\n* As global defaults (``kind: defaults`` \u2192 ``defaults: TestConfig``).\n\nThe loader deep-merges layers in order: built-in \u2192 global \u2192 suite \u2192 test.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stable unique test identifier (required for kind=test)",
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable test name",
          "title": "Name"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Test definition version (semver)",
